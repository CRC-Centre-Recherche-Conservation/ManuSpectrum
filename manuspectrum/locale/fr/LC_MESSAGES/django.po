#: templates/index.htm:13
msgid "ManuSpectrum — Physicochemical Analysis of Heritage"
msgstr "ManuSpectrum — Analyse physico-chimique du patrimoine"

#: templates/index.htm:14
msgid ""
"Open heritage science database of physicochemical analyses — XRF, Raman, "
"FTIR, FORS — of manuscripts, printed books and inscriptions: pigments, inks, "
"supports."
msgstr ""
"Base de données ouverte de sciences du patrimoine : analyses physico-"
"chimiques — XRF, Raman, FTIR, FORS — de manuscrits, imprimés et "
"inscriptions : pigments, encres, supports."

