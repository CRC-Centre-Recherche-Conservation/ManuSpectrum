{
    "name": "manuspectrum",
    "license": "AGPL-3.0-only",
    "scripts": {
        "build_development": "npm run eslint:check && npm run ts:check && cross-env webpack --config ./webpack/webpack.config.dev.js",
        "build_production": "npm run eslint:check && npm run ts:check && cross-env webpack --config ./webpack/webpack.config.prod.js",
        "build_test": "npm run eslint:check && npm run ts:check && cross-env webpack --config ./webpack/webpack.config.dev.js --env test=true",
        "eslint:check": "eslint manuspectrum/media/js manuspectrum/src",
        "eslint:fix": "eslint --fix",
        "eslint:fix:all": "eslint --fix manuspectrum/media/js manuspectrum/src",
        "eslint:watch": "nodemon --watch . --ext ts,vue --exec npm run --silent eslint:check",
        "gettext:extract": "vue-gettext-extract",
        "gettext:compile": "vue-gettext-compile",
        "prettier:check": "prettier manuspectrum/src --check",
        "prettier:fix": "prettier --write",
        "prettier:fix:all": "npm run prettier:fix **/src",
        "ts:check": "vue-tsc --noEmit",
        "ts:watch": "vue-tsc --watch --noEmit",
        "start": "cross-env webpack serve --config ./webpack/webpack.config.dev.js",
        "vitest": "vitest --run --coverage"
    },
    "dependencies": {
        "@primeuix/themes": "^1.2.3",
        "@uppy/aws-s3": "3.6.2",
        "@uppy/companion-client": "3.1.3",
        "@uppy/core": "3.13.0",
        "@uppy/dashboard": "3.9.0",
        "@uppy/drag-drop": "3.1.0",
        "@uppy/progress-bar": "3.1.1",
        "@vueuse/core": "^15.0.0",
        "arches": "archesproject/arches#stable/8.1.4",
        "arches_controlled_lists": "archesproject/arches-controlled-lists#stable/1.2.0",
        "arches_vue_components": "archesproject/arches-vue-components#stable/2.0.2",
        "dompurify": "^3.4.16",
        "es-toolkit": "^1.44.0",
        "gridstack": "^14.0.0",
        "leaflet": "1.6.0",
        "leaflet-iiif": "3.0.0",
        "leaflet.markercluster": "^1.5.3",
        "maplibre-gl": "^4.7.1",
        "papaparse": "^5.5.3",
        "pinia": "^3.0.4",
        "plotly.js-cartesian-dist": "^4.0.0",
        "primelocale": "^2.5.0",
        "primevue": "4.3.7",
        "typescript": "5.6.2",
        "uuid": "^11"
    },
    "devDependencies": {
        "@types/geojson": "^7946.0.16",
        "@types/leaflet": "^1.9.22",
        "@types/leaflet.markercluster": "^1.5.6",
        "@types/plotly.js": "^3.0.14",
        "arches-dev-dependencies": "archesproject/arches-dev-dependencies#stable/8.1.4",
        "webpack": "^5.110.3"
    },
    "nodeModulesPaths": {},
    "overrides": {
        "arches": "archesproject/arches#stable/8.1.4",
        "moment-timezone": "^0.5.45",
        "nomnom": "npm:@gerhobbelt/nomnom",
        "rimraf": "^5.0.7",
        "underscore": "^1.13.6"
    }
}
