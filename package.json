{
    "name": "manuspectrum",
    "version": "1.0.2",
    "license": "AGPL-3.0-only",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build_development": "npm run eslint:check && npm run ts:check && cross-env webpack --config ./webpack/webpack.config.dev.js --config ./webpack.project.js --merge",
        "build_production": "npm run eslint:check && npm run ts:check && cross-env webpack --config ./webpack/webpack.config.prod.js --config ./webpack.project.js --merge",
        "build_test": "npm run eslint:check && npm run ts:check && cross-env webpack --config ./webpack/webpack.config.dev.js --config ./webpack.project.js --merge --env test=true",
        "eslint:check": "eslint manuspectrum/media/js manuspectrum/src",
        "eslint:fix": "eslint --fix",
        "eslint:fix:all": "eslint --fix manuspectrum/media/js manuspectrum/src",
        "eslint:watch": "nodemon --watch . --ext ts,vue --exec npm run --silent eslint:check",
        "gettext:extract": "vue-gettext-extract",
        "gettext:compile": "vue-gettext-compile",
        "prettier:check": "prettier manuspectrum/src --check",
        "prettier:fix": "prettier --write",
        "prettier:fix:all": "npm run prettier:fix **/src",
        "ts:check": "vue-tsc --noEmit",
        "ts:watch": "vue-tsc --watch --noEmit",
        "start": "cross-env webpack serve --config ./webpack/webpack.config.dev.js --config ./webpack.project.js --merge",
        "vitest": "vitest --run --coverage"
    },
    "dependencies": {
        "@openvue/themes": "1.0.0",
        "@vueuse/core": "^15.0.0",
        "arches": "archesproject/arches#v8.2.0-alpha.25",
        "dompurify": "3.4.17",
        "es-toolkit": "1.50.0",
        "gridstack": "14.0.0",
        "leaflet": "1.6.0",
        "leaflet-iiif": "3.0.0",
        "leaflet.markercluster": "^1.5.3",
        "maplibre-gl": "6.9.0",
        "openvue": "1.0.0",
        "papaparse": "^5.7.0",
        "pinia": "3.0.4",
        "plotly.js-cartesian-dist": "^4.1.2",
        "primeicons": "7.0.0",
        "primelocale": "^2.6.2",
        "typescript": "5.9.3",
        "uuid": "^11"
    },
    "devDependencies": {
        "@babel/core": "^7.29.6",
        "@babel/plugin-syntax-dynamic-import": "7.8.3",
        "@babel/plugin-transform-class-properties": "7.28.6",
        "@babel/plugin-transform-runtime": "7.29.0",
        "@babel/preset-env": "7.29.0",
        "@eslint/js": "10.0.1",
        "@maplibre/maplibre-gl-style-spec": "26.8.0",
        "@types/codemirror": "5.60.18",
        "@types/geojson": "7946.0.16",
        "@types/js-cookie": "3.0.6",
        "@types/leaflet": "^1.9.22",
        "@types/leaflet.markercluster": "^1.5.6",
        "@types/node": "^24.19.2",
        "@types/plotly.js": "^3.0.15",
        "@typescript-eslint/parser": "8.57.0",
        "@vitejs/plugin-vue": "6.0.10",
        "@vitest/coverage-v8": "5.0.5",
        "@vue/test-utils": "2.4.6",
        "babel-loader": "9.2.1",
        "clean-webpack-plugin": "4.0.0",
        "cross-env": "7.0.3",
        "cross-fetch": "3.2.0",
        "css-loader": "7.1.4",
        "css-minimizer-webpack-plugin": "^8.0.0",
        "eslint": "10.8.0",
        "eslint-config-prettier": "9.1.0",
        "eslint-plugin-vue": "10.10.0",
        "globals": "17.8.0",
        "jsdom": "24.1.3",
        "mini-css-extract-plugin": "2.10.1",
        "nodemon": "3.1.14",
        "postcss": "8.5.32",
        "postcss-loader": "8.2.1",
        "prettier": "3.3.0",
        "sass": "1.78.0",
        "sass-loader": "14.2.1",
        "style-loader": "4.0.0",
        "stylelint": "16.26.1",
        "stylelint-config-standard": "36.0.1",
        "stylelint-webpack-plugin": "5.1.0",
        "ts-loader": "9.5.4",
        "typescript-eslint": "8.57.0",
        "vitest": "5.0.5",
        "vue-loader": "17.4.2",
        "vue-tsc": "3.3.8",
        "webpack": "5.112.0",
        "webpack-cli": "5.1.4",
        "webpack-dev-server": "5.2.7",
        "webpack-merge": "5.10.0"
    },
    "nodeModulesPaths": {
        "uuid-esm": "node_modules/uuid/dist/esm-browser/index.js"
    },
    "overrides": {
        "@babel/core": "$@babel/core",
        "arches": "archesproject/arches#v8.2.0-alpha.25",
        "brace-expansion@^5.0.8": "^5.0.12",
        "js-yaml": "^4.3.2",
        "moment-timezone": "^0.5.45",
        "nomnom": "npm:@gerhobbelt/nomnom",
        "qs": "^6.16.2",
        "rimraf": "^5.0.7",
        "sockjs": {
            "uuid": "^11.1.1"
        },
        "underscore": "^1.13.6",
        "vue": "3.5.44",
        "webpack-dev-server": "$webpack-dev-server"
    }
}
