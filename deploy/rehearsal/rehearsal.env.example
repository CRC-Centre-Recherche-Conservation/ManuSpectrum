# Copy this file to rehearsal.env (ignored by Git), then put the real
# production values in it, locally only. Never in Git.

# Administrator account created by the installer (use the real production name locally).
ADMIN_USER=admin1
# Second administrator account (use the real production name locally).
ADMIN2_USER=admin2
# SSH public key of the second account, one line; empty = no key.
ADMIN2_PUBKEY=
# yes or no: use the real production value locally.
SSH_PASSWORD_AUTH=no
# true or false: automatic reboot after updates; use the real production value locally.
UNATTENDED_REBOOT=false
# Time of the automatic reboot (HH:MM); use the real production value locally.
UNATTENDED_REBOOT_TIME=03:30
# Recipient of the postfix root alias; empty = no alias.
ROOT_ALIAS=
# SMTP relay (host:port); empty = postfix "Local only". Use the real production value locally.
SMTP_RELAY=
# NFS server as seen from the VM; use the real production value locally if it differs.
NFS_SERVER=192.168.123.1
# Directory exported by the host (host-nfs.sh) and mounted as /data by the VM.
# A directory on a secondary disk is fine; see README.
NFS_EXPORT_DIR=/srv/ms-rehearsal-data
# Directory of the VM disk and seed ISO (make-vm.sh); copy the Ubuntu ISO there.
# A directory on a secondary disk is fine; see README.
IMAGES_DIR=/var/lib/libvirt/images
# Docker apt repository suite to force (e.g. noble); empty = the distribution's own.
DOCKER_APT_CODENAME=
# Number of vCPUs of the VM; use the real production value locally.
VCPUS=4
# VM memory in MiB; use the real production value locally.
RAM_MB=8192
# Disk size in GiB; use the real production value locally.
DISK_GB=60
# Size of the root logical volume; use the real production value locally.
ROOT_LV_SIZE=50G
# System locale; use the real production value locally.
LOCALE=en_US.UTF-8
# Keyboard layout; use the real production value locally.
KEYBOARD=us
# NFS export options of the host (host-nfs.sh); use the real production value locally.
NFS_EXPORT_OPTIONS=rw,sync,root_squash,no_subtree_check
# NFS version expected by verify-baseline.sh (major, e.g. 4, or major.minor, e.g. 4.1).
NFS_VERS=4
