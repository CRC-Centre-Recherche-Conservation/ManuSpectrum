# Copier ce fichier en rehearsal.env (ignoré par Git) puis y mettre les
# valeurs réelles de la prod, en local seulement. Jamais dans Git.

# Compte administrateur créé par l'installeur (mettre le nom réel de la prod en local).
ADMIN_USER=admin1
# Second compte administrateur (mettre le nom réel de la prod en local).
ADMIN2_USER=admin2
# Clé publique SSH du second compte, une ligne ; vide = aucune clé.
ADMIN2_PUBKEY=
# yes ou no : mettre la valeur réelle de la prod en local.
SSH_PASSWORD_AUTH=no
# true ou false : redémarrage automatique après mise à jour ; mettre la valeur réelle de la prod en local.
UNATTENDED_REBOOT=false
# Heure du redémarrage automatique (HH:MM) ; mettre la valeur réelle de la prod en local.
UNATTENDED_REBOOT_TIME=03:30
# Destinataire de l'alias root de postfix ; vide = aucun alias.
ROOT_ALIAS=
# Relais SMTP (hôte:port) ; vide = postfix « Local only ». Mettre la valeur réelle de la prod en local.
SMTP_RELAY=
# Serveur NFS vu depuis la VM ; mettre la valeur réelle de la prod en local si elle diffère.
NFS_SERVER=192.168.123.1
# Chemin exporté par le serveur NFS ; mettre la valeur réelle de la prod en local si elle diffère.
NFS_EXPORT=/srv/ms-rehearsal-data
# Suite du dépôt apt Docker à forcer (ex. noble) ; vide = celle de la distribution.
DOCKER_APT_CODENAME=
# Nombre de vCPU de la VM ; mettre la valeur réelle de la prod en local.
VCPUS=4
# Mémoire de la VM en Mio ; mettre la valeur réelle de la prod en local.
RAM_MB=8192
# Taille du disque en Gio ; mettre la valeur réelle de la prod en local.
DISK_GB=60
# Taille du volume logique racine ; mettre la valeur réelle de la prod en local.
ROOT_LV_SIZE=50G
# Locale du système ; mettre la valeur réelle de la prod en local.
LOCALE=en_US.UTF-8
# Disposition du clavier ; mettre la valeur réelle de la prod en local.
KEYBOARD=us
# Options d'export NFS du portable (host-nfs.sh) ; mettre la valeur réelle de la prod en local.
NFS_EXPORT_OPTIONS=rw,sync,root_squash,no_subtree_check
# Version NFS attendue par verify-baseline.sh (majeure, ex. 4, ou majeure.mineure, ex. 4.1).
NFS_VERS=4
