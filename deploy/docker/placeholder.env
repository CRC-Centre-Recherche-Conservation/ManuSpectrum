# Values that let Django start without any service: build steps of the
# Dockerfile and probe-image.sh. None of them is a secret; a running stack
# never reads this file.
DJANGO_SETTINGS_MODULE=manuspectrum.settings_docker
MANUSPECTRUM_SECRET_KEY=placeholder-not-a-secret-00000000000000000000000000000000
DOMAIN_NAMES=placeholder.invalid
PUBLIC_SERVER_ADDRESS=https://placeholder.invalid/
PGDBNAME=placeholder
PGUSERNAME=placeholder
PGPASSWORD=placeholder
PGHOST=placeholder.invalid
PGPORT=5432
ESHOST=placeholder.invalid
ESPORT=9200
ELASTIC_PASSWORD=placeholder
REDIS_BROKER_URL=redis://placeholder.invalid:6379
REDIS_CACHE_URL=redis://placeholder.invalid:6379
CANTALOUPE_HOST=placeholder.invalid
CANTALOUPE_PORT=8182
CONTACT_EMAIL=contact@placeholder.invalid
EMAIL_HOST=placeholder.invalid
EMAIL_PORT=25
