# Renews the Let's Encrypt certificate of the stack (CERT_MODE=acme) and
# reloads nginx when it changed. PP-8 substitutes the two placeholders and
# installs this file with the timer next to it.
[Unit]
Description=ManuSpectrum certificate renewal
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=@APP_USER@
ExecStart=/usr/bin/make -C @DEPLOY_DIR@ cert-renew
