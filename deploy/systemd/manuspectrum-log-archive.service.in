# Archives the closed server logs (rotated nginx logs, rotated /var/log
# files, archived journal files) into TSM once, through `dsmc archive`
# (scripts/log-archive.sh). Runs as root: dsmc and /var/log need it; it does
# nothing where dsmc is not installed. It runs the root-owned copy of the
# script, never the checkout; /etc/manuspectrum/log-archive.env holds its
# paths. PP-8 installs this file with the timer next to it.
[Unit]
Description=ManuSpectrum log archive into TSM
After=remote-fs.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/manuspectrum/log-archive.env
ExecStart=/usr/local/lib/manuspectrum/log-archive/log-archive.sh
TimeoutStartSec=2h
Nice=19
IOSchedulingClass=idle
