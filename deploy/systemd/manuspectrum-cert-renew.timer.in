# Twice a day, as Let's Encrypt recommends; certbot renews only a certificate
# with 30 days or less left. Enabled by PP-8 when CERT_MODE=acme.
[Unit]
Description=Check the ManuSpectrum certificate twice a day

[Timer]
OnCalendar=*-*-* 00,12:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
