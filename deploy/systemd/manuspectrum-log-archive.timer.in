# Every day at 07:30, after the nightly backup (02:00) and the reboot window
# (04:50); Persistent=true runs a missed day at the next boot. Enabled by PP-8.
[Unit]
Description=Archive the ManuSpectrum closed logs every day

[Timer]
OnCalendar=*-*-* 07:30
Persistent=true

[Install]
WantedBy=timers.target
