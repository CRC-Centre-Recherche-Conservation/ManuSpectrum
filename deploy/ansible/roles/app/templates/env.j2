# Rendered by deploy/ansible (app role) from the inventory; edits are overwritten at the next run.
# No secret belongs here: they are files in SECRETS_DIR (deploy/SECRETS.md).

# --- Compose ---
DEPLOY_ENVIRONMENT={{ env_deploy_environment }}
MANUSPECTRUM_IMAGE={{ app_image_in_service }}
COMPOSE_PROFILES={{ env_compose_profiles }}
APP_UID={{ app_uid }}
APP_GID={{ app_gid }}
MEDIA_HOST_DIR={{ env_media_host_dir }}
PKG_DIR={{ env_pkg_dir }}
SECRETS_DIR={{ env_secrets_dir }}

# --- Backups (deploy/BACKUP.md) ---
BACKUP_DUMP_DIR={{ env_backup_dump_dir }}
RESTIC_REPOSITORY_DIR={{ env_restic_repository_dir }}
METRICS_TEXTFILE_DIR={{ env_metrics_textfile_dir }}

# --- Monitoring (profile observability) ---
ALERT_EMAILS={{ env_alert_emails }}
ALERT_EMAIL_FROM={{ env_alert_email_from }}

# --- nginx and TLS (deploy/certs/README.md) ---
CERT_MODE={{ env_cert_mode }}
CERTS_DIR={{ env_certs_dir }}
NGINX_LOG_HOST_DIR={{ env_nginx_log_host_dir }}
HSTS_MAX_AGE={{ env_hsts_max_age }}
LOCAL_CA_CERT={{ env_local_ca_cert }}
HTTP_PORT={{ env_http_port }}
HTTPS_PORT={{ env_https_port }}
ACME_EMAIL={{ env_acme_email }}
ACME_SERVER={{ env_acme_server }}

# --- Django (manuspectrum/settings_docker.py) ---
DOMAIN_NAMES={{ env_domain_names }}
PUBLIC_SERVER_ADDRESS={{ env_public_server_address }}
PUBLIC_HOST={{ env_public_host }}
PGDBNAME={{ env_pgdbname }}
PGUSERNAME={{ env_pgusername }}
ELASTICSEARCH_PREFIX={{ env_elasticsearch_prefix }}
CONTACT_EMAIL={{ env_contact_email }}
EMAIL_HOST={{ env_email_host }}
EMAIL_PORT={{ env_email_port }}
EMAIL_USE_TLS={{ env_email_use_tls }}
DEFAULT_FROM_EMAIL={{ env_default_from_email }}
ADMINS={{ env_admins }}
CORS_ALLOWED_ORIGINS={{ env_cors_allowed_origins }}
FORCE_TWO_FACTOR_AUTHENTICATION={{ env_force_two_factor_authentication }}
RELATED_RESOURCES_EXPORT_LIMIT={{ env_related_resources_export_limit }}
EXPLORER_UI_ONLY={{ env_explorer_ui_only }}
