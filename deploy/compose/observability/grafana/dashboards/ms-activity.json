    {
      "id": 2,
      "type": "timeseries",
      "title": "Consultations per day by kind",
      "description": "GET requests answered 2xx or 304 by kind of page or file (recording rule manuspectrum:consultations:total), per day. Robots are counted, and a 304 counts. The Explorer remembers payloads per tab for five minutes, so a document opened twice within five minutes counts once. IIIF kinds count requests, not views: a viewer page turn fetches several.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (kind) (increase(manuspectrum:consultations:total[1d]))",
          "legendFormat": "{{kind}}",
          "instant": false,
          "range": true,
          "interval": "1d"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "drawStyle": "bars"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "timeFrom": "30d"
    },
