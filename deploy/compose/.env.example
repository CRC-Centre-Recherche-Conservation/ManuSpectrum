# deploy/compose/.env.example
# Copy to deploy/compose/.env and adapt. No secret here: passwords and the
# Django key are files in SECRETS_DIR (see secrets/README.md). The values
# below are safe examples, never the ones of a real host.

# --- Compose ---
# `production` unless this is the rehearsal VM: only a rehearsal host sets
# `rehearsal` (an explicit step of the rehearsal procedure), which lets
# `make load-snapshot` replace the database. The command also requires the
# marker file /etc/manuspectrum/rehearsal-host, which only the rehearsal VM has.
DEPLOY_ENVIRONMENT=production
MANUSPECTRUM_IMAGE=manuspectrum:local
# Compose profiles every command enables. `observability` runs Prometheus,
# Alertmanager, Grafana and the exporters (deploy/OBSERVABILITY.md); empty
# keeps them off. Never put `mailpit` here: it is for CI and the rehearsal.
COMPOSE_PROFILES=observability
# uid/gid of the host service account that owns MEDIA_HOST_DIR
# (`id -u <account>`, `id -g <account>`); web, worker and beat run under them.
APP_UID=10001
APP_GID=10001
# Host directory of the uploaded files (MEDIA_ROOT); it must exist, with an
# uploadedfiles/ subdirectory, both owned by APP_UID:APP_GID, directories 0750
# and files 0640: Cantaloupe reads them through the APP_GID group. Example path.
MEDIA_HOST_DIR=/data/manuspectrum/media
# The data package (graphs, controlled lists, System Settings): the `pkg` git
# submodule of the repository (`git submodule update --init`). `make init` mounts
# it read-only into the init container; the image never contains it. Relative to
# deploy/compose, or absolute.
PKG_DIR=../../pkg
# Directory of the secret files, readable only by the service account; the
# `make` targets read it from here too. Example path: keep it outside the
# directories the provider's file backup (TSM) covers by default, so the secrets
# never leave the host in clear. The service account must own the parent
# directory (SECRETS.md, section 2).
SECRETS_DIR=/srv/manuspectrum/secrets

# --- Backups (deploy/BACKUP.md) ---
# Local disk of the service account: the last two nightly dumps (latest/ and
# previous/). Example path.
BACKUP_DUMP_DIR=/home/manuspectrum/backups
# Encrypted restic repository, on the network filesystem. Example path.
RESTIC_REPOSITORY_DIR=/data/manuspectrum/backups/restic
# Textfile collector directory of the metrics, on the local disk. Example path.
METRICS_TEXTFILE_DIR=/home/manuspectrum/metrics

# --- Monitoring (profile observability) ---
# Recipients of the alert e-mails, the Monday heartbeat and the monthly report:
# comma-separated, real addresses on the host only (never in Git). Example values.
ALERT_EMAILS=alerts@manuspectrum.test
# Sender; the SMTP relay (EMAIL_HOST, EMAIL_PORT) must accept it.
ALERT_EMAIL_FROM=manuspectrum@manuspectrum.test

# --- nginx and TLS (deploy/certs/README.md) ---
# local: a rehearsal CA made by `make certs-local`; acme: Let's Encrypt through
# certbot; provided: the operator drops fullchain.pem and privkey.pem.
CERT_MODE=local
# Host directory with four subdirectories: live/ (fullchain.pem and privkey.pem,
# the only thing besides acme-webroot/ that nginx mounts, read-only), acme-webroot/,
# letsencrypt/ (certbot state, acme mode) and ca/ (ca.crt and ca.key, local
# mode). Example path.
CERTS_DIR=/data/manuspectrum/certs
# Host directory of the nginx access and error logs (owned by APP_UID:APP_GID,
# 0750; rotated for thirty days by the host logrotate file). Example path.
NGINX_LOG_HOST_DIR=/data/manuspectrum/nginx-logs
# Strict-Transport-Security max-age in seconds: 3600 for the first week, then 31536000.
HSTS_MAX_AGE=3600
# CERT_MODE=local only: the CA certificate web and worker trust, so that they
# can call the public name (a rehearsal sets it to ${CERTS_DIR}/ca/ca.crt, as a
# literal path). Empty otherwise. Never the TLS private key.
LOCAL_CA_CERT=
# Host ports published by nginx.
HTTP_PORT=80
HTTPS_PORT=443
# certbot (CERT_MODE=acme): a contact address, and the Let's Encrypt staging
# directory until a staging run has succeeded.
ACME_EMAIL=
ACME_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# --- Django (manuspectrum/settings_docker.py) ---
DOMAIN_NAMES=manuspectrum.test
# https, with the trailing slash: Compose appends `iiifserver` to it (the Cantaloupe
# base URI) and the settings refuse a value without it.
PUBLIC_SERVER_ADDRESS=https://manuspectrum.test/
# The host name of PUBLIC_SERVER_ADDRESS (no port): nginx answers to it on the
# internal network, so that web can fetch the public image-service URLs.
PUBLIC_HOST=manuspectrum.test
PGDBNAME=manuspectrum
# Superuser of the PostgreSQL container; must differ from PGDBNAME (setup_db).
PGUSERNAME=postgres
ELASTICSEARCH_PREFIX=manuspectrum
CONTACT_EMAIL=contact@manuspectrum.test
EMAIL_HOST=smtp.manuspectrum.test
EMAIL_PORT=25
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=
ADMINS=
CORS_ALLOWED_ORIGINS=
