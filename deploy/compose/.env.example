# deploy/compose/.env.example
# Copy to deploy/compose/.env and adapt. No secret here: passwords and the
# Django key are files in SECRETS_DIR (see secrets/README.md). The values
# below are safe examples, never the ones of a real host.

# --- Compose ---
# `production` unless this is the rehearsal VM: only a rehearsal host sets
# `rehearsal` (an explicit step of the rehearsal procedure), which lets
# `make load-snapshot` replace the database. The command also requires the
# marker file /etc/manuspectrum/rehearsal-host, which only the rehearsal VM has.
DEPLOY_ENVIRONMENT=production
MANUSPECTRUM_IMAGE=manuspectrum:local
# uid/gid of the host service account that owns MEDIA_HOST_DIR
# (`id -u <account>`, `id -g <account>`); web, worker and beat run under them.
APP_UID=10001
APP_GID=10001
# Host directory of the uploaded files (MEDIA_ROOT); it must exist, with an
# uploadedfiles/ subdirectory, both owned by APP_UID:APP_GID, directories 0750
# and files 0640: Cantaloupe reads them through the APP_GID group. Example path.
MEDIA_HOST_DIR=/data/manuspectrum/media
# Directory of the secret files, readable only by the service account.
SECRETS_DIR=./secrets

# --- Django (manuspectrum/settings_docker.py) ---
DOMAIN_NAMES=manuspectrum.test
# https, with the trailing slash: Compose appends `iiifserver` to it (the Cantaloupe
# base URI) and the settings refuse a value without it.
PUBLIC_SERVER_ADDRESS=https://manuspectrum.test/
PGDBNAME=manuspectrum
# Superuser of the PostgreSQL container; must differ from PGDBNAME (setup_db).
PGUSERNAME=postgres
ELASTICSEARCH_PREFIX=manuspectrum
CONTACT_EMAIL=contact@manuspectrum.test
EMAIL_HOST=smtp.manuspectrum.test
EMAIL_PORT=25
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=
ADMINS=
CORS_ALLOWED_ORIGINS=
